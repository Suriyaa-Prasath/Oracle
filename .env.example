# Copy to `.env` and edit. Everything is optional — src/config.py has defaults.

# --- Provider: "ollama" (local) or "groq" (deployed) ---
ORACLE_PROVIDER=ollama

# --- Local path ---
ORACLE_OLLAMA_HOST=http://localhost:11434
ORACLE_OLLAMA_MODEL=llama3.1

# --- Hosted path (same Llama 3.1 weights) ---
# Free key: https://console.groq.com/keys
ORACLE_GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=gsk_...

# Optional: a smaller model for the router, which only emits one word.
# ORACLE_ROUTER_MODEL=llama3.2:3b

# --- Embeddings (changing this requires deleting chroma/) ---
ORACLE_EMBED_MODEL=all-MiniLM-L6-v2

# --- Retrieval ---
ORACLE_TOP_K=5
ORACLE_SCORE_THRESHOLD=0.25
ORACLE_CHUNK_SIZE=800
ORACLE_CHUNK_OVERLAP=120
